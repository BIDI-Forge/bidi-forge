{
  "name": "bidi-forge",
  "displayName": "BIDI · Forge",
  "description": "Fix mixed Persian, Arabic, and English (RTL/LTR) text in VS Code with Unicode bidi markers—selection, clipboard, and optional RTL UI CSS.",
  "version": "0.3.2",
  "private": false,
  "type": "module",
  "publisher": "amirmkazemi",
  "icon": "icon.png",
  "license": "MIT",
  "markdown": "github",
  "qna": "https://github.com/BIDI-Forge/bidi-forge/discussions",
  "galleryBanner": {
    "color": "#0d3b2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BIDI-Forge/bidi-forge.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/BIDI-Forge/bidi-forge#readme",
  "bugs": {
    "url": "https://github.com/BIDI-Forge/bidi-forge/issues"
  },
  "keywords": [
    "rtl",
    "ltr",
    "bidi",
    "persian",
    "farsi",
    "arabic",
    "hebrew",
    "unicode",
    "mixed-script",
    "multilingual",
    "accessibility",
    "formatter",
    "vscode",
    "vscodium",
    "openvsx",
    "clipboard",
    "i18n",
    "markdown",
    "ai-chat"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Accessibility"
  ],
  "activationEvents": [
    "onCommand:rtlFixer.fixSelectedText",
    "onCommand:rtlFixer.fixClipboardText",
    "onCommand:rtlFixer.enableRtlUi",
    "onCommand:rtlFixer.disableRtlUi",
    "onCommand:rtlFixer.openSettings"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "configuration": {
      "title": "%rtlFixer.configuration.title%",
      "properties": {
        "rtlFixer.uiMessageDirection": {
          "type": "string",
          "enum": ["rtl", "ltr", "auto"],
          "default": "rtl",
          "description": "%rtlFixer.uiMessageDirection.description%"
        },
        "rtlFixer.fixOnPaste": {
          "type": "boolean",
          "default": false,
          "description": "%rtlFixer.fixOnPaste.description%"
        }
      }
    },
    "commands": [
      {
        "command": "rtlFixer.fixSelectedText",
        "title": "%rtlFixer.fixSelectedText.title%"
      },
      {
        "command": "rtlFixer.fixClipboardText",
        "title": "%rtlFixer.fixClipboardText.title%"
      },
      {
        "command": "rtlFixer.enableRtlUi",
        "title": "%rtlFixer.enableRtlUi.title%"
      },
      {
        "command": "rtlFixer.disableRtlUi",
        "title": "%rtlFixer.disableRtlUi.title%"
      },
      {
        "command": "rtlFixer.openSettings",
        "title": "%rtlFixer.openSettings.title%"
      }
    ],
    "keybindings": [
      {
        "command": "rtlFixer.fixSelectedText",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "rtlFixer.fixClipboardText",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node --experimental-strip-types esbuild.config.ts",
    "dev": "node --experimental-strip-types esbuild.config.ts --watch",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" esbuild.config.ts --ignore-pattern \"src/**/__tests__/**\" --max-warnings=0",
    "package": "pnpm build && node scripts/package-vsix.mjs",
    "smoke:vsix": "node ../../scripts/smoke-vsix.mjs",
    "publish:marketplace": "pnpm package && vsce publish --no-dependencies",
    "publish:ovsx": "pnpm package && pnpm dlx ovsx publish BIDI-Forge-*.vsix -p \"$OPEN_VSX_TOKEN\""
  },
  "dependencies": {
    "@bidi-forge/core": "workspace:*",
    "@rtl-text-fixer/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.1",
    "vitest": "^3.2.4"
  }
}
