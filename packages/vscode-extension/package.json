{
  "name": "rtl-text-fixer",
  "displayName": "RTL Text Fixer",
  "description": "Fix mixed Persian (RTL) and English (LTR) text readability by inserting Unicode bidi markers.",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "publisher": "rtl-text-fixer",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BIDI-Forge/bidi-forge.git"
  },
  "homepage": "https://github.com/BIDI-Forge/bidi-forge",
  "bugs": {
    "url": "https://github.com/BIDI-Forge/bidi-forge/issues"
  },
  "keywords": [
    "rtl",
    "persian",
    "farsi",
    "bidi",
    "unicode",
    "cursor",
    "vscode"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:rtlFixer.fixSelectedText",
    "onCommand:rtlFixer.fixClipboardText",
    "onCommand:rtlFixer.enableRtlUi",
    "onCommand:rtlFixer.disableRtlUi",
    "onCommand:rtlFixer.openSettings"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "configuration": {
      "title": "RTL Text Fixer",
      "properties": {
        "rtlFixer.uiMessageDirection": {
          "type": "string",
          "enum": ["rtl", "ltr", "auto"],
          "default": "rtl",
          "description": "Base direction for extension notification messages."
        },
        "rtlFixer.fixOnPaste": {
          "type": "boolean",
          "default": false,
          "description": "Automatically fix mixed text on paste (reserved; not yet implemented)."
        }
      }
    },
    "commands": [
      {
        "command": "rtlFixer.fixSelectedText",
        "title": "RTL Fixer: اصلاح متن انتخاب‌شده"
      },
      {
        "command": "rtlFixer.fixClipboardText",
        "title": "RTL Fixer: اصلاح متن کلیپ‌بورد"
      },
      {
        "command": "rtlFixer.enableRtlUi",
        "title": "RTL Fixer: فعال‌سازی RTL برای UI (با Custom CSS)"
      },
      {
        "command": "rtlFixer.disableRtlUi",
        "title": "RTL Fixer: غیرفعال‌سازی RTL برای UI (با Custom CSS)"
      },
      {
        "command": "rtlFixer.openSettings",
        "title": "RTL Fixer: تنظیمات و راهنما"
      }
    ],
    "keybindings": [
      {
        "command": "rtlFixer.fixSelectedText",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "rtlFixer.fixClipboardText",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.ts",
    "dev": "node esbuild.config.ts --watch",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" esbuild.config.ts --ignore-pattern \"src/**/__tests__/**\" --max-warnings=0",
    "package": "pnpm build && vsce package --no-dependencies",
    "publish": "pnpm build && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@rtl-text-fixer/core": "workspace:*",
    "@rtl-text-fixer/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.1",
    "vitest": "^3.2.4"
  }
}
