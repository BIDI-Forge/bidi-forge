{
  "name": "@bidi-forge/core",
  "version": "0.2.0",
  "private": false,
  "description": "Unicode BiDi engine for mixed Persian, Arabic, and English text",
  "license": "MIT",
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/BIDI-Forge/bidi-forge.git",
    "directory": "packages/core"
  },
  "keywords": ["bidi", "rtl", "persian", "arabic", "unicode", "farsi"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "pnpm vitest run",
    "test:watch": "pnpm vitest",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/**/__tests__/**\" --max-warnings=0"
  },
  "dependencies": {
    "@rtl-text-fixer/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
