{
  "name": "@rtl-text-fixer/chrome-extension",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "node --experimental-strip-types esbuild.config.ts",
    "pack:store": "pnpm icons && pnpm build && node scripts/pack-store-zip.mjs",
    "dev": "node --experimental-strip-types esbuild.config.ts --watch",
    "lint": "eslint src esbuild.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bidi-forge/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "esbuild": "^0.25.1",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.4"
  }
}
