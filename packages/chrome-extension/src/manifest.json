{
  "manifest_version": 3,
  "name": "RTL Text Fixer",
  "version": "0.3.4",
  "description": "Fix mixed Persian, Arabic, and English text order on websites and AI chat (ChatGPT, Claude, Gemini) using Unicode BiDi markers.",
  "homepage_url": "https://github.com/BIDI-Forge/bidi-forge",
  "author": "Tocka69",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RTL Text Fixer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
